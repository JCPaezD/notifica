<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema base de la app para Android 12+ -->
    <style name="Theme.Notifica" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <!-- Tema específico para la SplashScreen moderna (API 31+) -->
    <style name="Theme.Notifica.Splash" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@null</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

</resources>
